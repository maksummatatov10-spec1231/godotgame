; Engine configuration file.
; Dungeon Survivors — Godot 4.3
config_version=5

[application]

config/name="Dungeon Survivors"
config/description="Pixel dungeon survivor. Выживи 10 минут в данжене!"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.png"

[autoload]

GameState="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.03, 0.015, 0.05, 1)
